# ---------------------------------------------------------------------------
# Public — safe to expose to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://cherbix.com"

# Analytics (all optional — features stay inert when unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ---------------------------------------------------------------------------
# Server-only — never referenced from client components
# ---------------------------------------------------------------------------
# Transactional email (Resend). Leave empty in development: submissions are
# logged to the server console instead of being delivered.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Cherbix Website <website@cherbix.com>"
CONTACT_TO_EMAIL="hello@cherbix.com"

# Sanity CMS (architecture is ready; not wired up yet)
SANITY_PROJECT_ID=""
SANITY_DATASET="production"
SANITY_API_READ_TOKEN=""
